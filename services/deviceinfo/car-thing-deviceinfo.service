[Unit]
Description=Car Thing device-info read-only service (fleet/queue/disk state for the dashboard)
After=network.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
# systemd user services do NOT inherit the shell PATH -- see
# scripts/car-thing-backlight.service for the same gotcha.
Environment=PATH=%h/.local/bin:__NODE_BIN_DIR__:/usr/local/bin:/usr/bin:/bin
# Host config (CAR_THING_SERIAL, CAR_THING_ADB, and the optional MB_HOST /
# MB_SSH_HOST / CODER_HOST / CONTROL_SCRIPTS_DIR) -- written by scripts/setup.sh.
# Leading '-' makes a missing file tolerated, not an error.
EnvironmentFile=-__REPO_ROOT__/superbird.conf
ExecStart=__NODE_BIN__ services/deviceinfo/server.js
Restart=always
RestartSec=5
# ⚠ LOAD-BEARING. Default KillMode=control-group kills EVERY process in the
# service's cgroup on stop/restart — including long-lived servers this service
# starts on request (the CONTROL slot's ROUTER START runs start-router.sh, and
# llama-server inherits this cgroup).
#
# Observed 2026-08-11: the device started the router successfully (action log
# exit=0), then a routine `systemctl --user stop car-thing-deviceinfo` took the
# router down with it — /tmp/llama-router.log ends "Received second interrupt,
# terminating immediately" at the exact stop_time. From the user's side the
# START button simply "did nothing".
#
# KillMode=process kills only the main node process and leaves spawned servers
# running, which is the whole point of an action that starts a daemon.
KillMode=process

[Install]
WantedBy=default.target
