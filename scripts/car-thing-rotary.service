[Unit]
Description=Car Thing rotary dial -> ArrowUp/ArrowDown bridge
After=claude-thing.service

[Service]
Type=simple
WorkingDirectory=%h/project/car-thing
# systemd user services do NOT inherit the shell PATH — see claude-thing.service
# for the same gotcha. Node must be reachable by absolute PATH entry.
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node scripts/rotary-bridge.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
