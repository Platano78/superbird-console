[Unit]
Description=Car Thing backlight attention channel
After=claude-thing.service

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
# systemd user services do NOT inherit the shell PATH — see claude-thing.service
# for the same gotcha. Node must be reachable by absolute PATH entry.
Environment=PATH=%h/.local/bin:__NODE_BIN_DIR__:/usr/local/bin:/usr/bin:/bin
# Host config (CAR_THING_SERIAL, CAR_THING_ADB) -- written by scripts/setup.sh.
# Leading '-' makes a missing file tolerated, not an error.
EnvironmentFile=-__REPO_ROOT__/superbird.conf
ExecStart=__NODE_BIN__ scripts/backlight-daemon.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
